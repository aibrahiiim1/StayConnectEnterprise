# CENTRAL (ctrlapi) SERVICE ENVIRONMENT — /etc/stayconnect/ctrlapi.env on the Central host (root, 0600).
#
# deploy/scripts/central-install.sh renders this file for you: it replaces the two CHANGE_ME passwords with the
# ones it generated into /opt/stayconnect/central/secrets/, and sets CTRLAPI_ALLOW_ORIGINS from --admin-name.
# Everything else is the value a production Central runs with. By hand: copy, fill in the CHANGE_ME values,
# leave the rest alone.
#
# Every value that a fresh Central deployment needs is named here, including the ones whose absence is
# silent: a Central missing CTRLAPI_APPLIANCE_BASE or CTRLAPI_VENDOR_KEY starts perfectly and simply cannot
# activate an appliance. Check a host with:  deploy/scripts/central-preflight.sh

# ---------------------------------------------------------------- identity of this deployment
CTRLAPI_ENV=production
# Loopback only: Caddy is the public face. ctrlapi trusts the client address Caddy forwards (X-Real-IP) only
# when the connection comes from loopback; anything connecting directly is identified by its own TCP address.
CTRLAPI_ADDR=127.0.0.1:8080
# debug | info | warn | error
CTRLAPI_LOG_LEVEL=info

# ---------------------------------------------------------------- backing services (deploy/compose/central-infra.yml)
# sslmode=disable is correct HERE and only here: Postgres is the sc-central-pg container published on
# 127.0.0.1 and never leaves the host; the timescale image runs without TLS, so sslmode=require would refuse
# to connect. If Postgres ever moves off this host, it gets TLS and this becomes verify-full.
CTRLAPI_DB_URL=postgres://stayconnect:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/stayconnect?sslmode=disable
CTRLAPI_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

# ---------------------------------------------------------------- the browser side
# Origins allowed to call this API from a browser. The human admin UI, nothing else — appliances do not use
# CORS. Must be the real admin origin(s), comma-separated; the built-in default is loopback only.
CTRLAPI_ALLOW_ORIGINS=https://sc-central.echofusion.com
CTRLAPI_COOKIE_SECURE=true

# ---------------------------------------------------------------- the appliance side
# What appliances dial — written into every offline activation package, and the address a hotel's appliance
# uses for the rest of its life.
#
# NORMALLY YOU DO NOT SET IT HERE. deploy/scripts/install-central-endpoint.sh installs the versioned
# deploy/config/central-endpoint.env to /etc/stayconnect/central-endpoint.env; the ctrlapi unit reads that file
# AFTER this one, so the fleet-wide value wins over anything hand-edited on a single host. The line below is a
# fallback, and central-preflight.sh reports when the two disagree.
#
# There is no default. Unset in both places, Central starts normally and offline first activation is
# DISABLED with a log line saying so, rather than minting packages that name an endpoint nobody operates.
CTRLAPI_APPLIANCE_BASE=https://sc-central.echofusion.com

# The appliance mutual-TLS listener. 9443 is the product's port: deploy/config/central-endpoint.env tells
# appliances CENTRAL_MTLS_BASE=https://<name>:9443, and central-firewall.sh opens exactly that port.
CTRLAPI_MTLS_ADDR=:9443

# Extra names/addresses the mTLS appliance listener's certificate must also be valid for. The certificate is
# issued for CTRLAPI_APPLIANCE_BASE's host plus 127.0.0.1 automatically; this is for a TRANSITION, where
# appliances already in the field still dial an old address. ctrlapi re-issues the certificate by itself
# when it finds one that does not cover every configured name, so changing the endpoint is one edit.
# CTRLAPI_MTLS_SANS=

# ---------------------------------------------------------------- signing identities (NEVER regenerate on a move)
# The vendor signing key: licences and offline activation packages. Created ONCE, ever (central-install.sh
# --mode new, via vendor-signing-key.sh init), and carried to any future Central host with central-export.sh /
# central-install.sh --mode restore. Every appliance in the field is pinned to its public half.
CTRLAPI_VENDOR_KEY=/etc/stayconnect/vendor-license.key

# Assignment signing — deliberately a DIFFERENT key from the vendor key. An assignment must not be
# signable by the licence key, and ctrlapi refuses to sign assignments if it finds the two are the same.
CTRLAPI_ASSIGN_KEY=/etc/stayconnect/assignment-signing.key

# Root of the signed assignment-key trust registry the appliance verifies.
CTRLAPI_REGISTRY_ROOT_KEY=/etc/stayconnect/assignment-registry-root.key

# ---------------------------------------------------------------- the appliance certificate authority
# Two-tier: an offline Root signs an online Intermediate; runtime issuance uses only the intermediate.
#
# On a BRAND-NEW Central the first start creates both (root + intermediate, certificates persisted beside the
# keys) and moves the root KEY to CTRLAPI_ROOT_CA_OFFLINE_DIR — from where it belongs in cold storage.
# On a MOVED Central these files are carried over by central-export.sh; if root-ca.crt or intermediate-ca.*
# were missing ctrlapi would silently mint a NEW CA and every appliance would stop trusting Central, which is
# why central-install.sh refuses to start ctrlapi in restore mode until they are present and chain.
CTRLAPI_ROOT_CA_KEY=/etc/stayconnect/pki/root-ca.key
CTRLAPI_INTERMEDIATE_CA_KEY=/etc/stayconnect/pki/intermediate-ca.key
CTRLAPI_ROOT_CA_OFFLINE_DIR=/etc/stayconnect/pki-offline
# Where the :9443 server certificate lives (server-mtls.crt/.key, rotated by ctrlapi before expiry).
CTRLAPI_SERVER_TLS_DIR=/etc/stayconnect/pki
# The CA bundle written into offline activation packages: the appliance CA chain (intermediate + root).
# A neutral name — the first Central kept it as nats-ca-bundle.crt, after a message bus Central no longer runs.
CTRLAPI_CA_BUNDLE=/etc/stayconnect/pki/ca-bundle.crt

# ---------------------------------------------------------------- portal hostnames and certificates
# docs/architecture/ONEGATE_HTTPS_PORTAL_AND_SOCIAL_LOGIN.md. Everything else (ACME directory, contact, zone,
# weekly limit, the DNS API token) is set from the console's Portal certificates page, not here.
# Root-only directory (0700) holding acme-account.key (created on first use) and dns-api.token (written by the
# console, never displayed). Both 0600. Carry it to a new Central host with the other secrets.
# CTRLAPI_PORTAL_TLS_DIR=/etc/stayconnect/portal-tls

# TEST-ONLY. Leave every line below commented on a production Central. Together they run the whole issuance
# chain against a temporary Pebble + pebble-challtestsrv (scripts/portaltls-pebble-test.sh), before a real
# DNS token exists. ctrlapi logs a WARN line at every start while any of them is set, and the console shows
# them on the Portal certificates page. Certificates issued this way are trusted by nobody.
#   DNS provider: cloudflare (default) | challtestsrv. challtestsrv needs no token (the contact email is still
#   required) and is driven through its management API base URL.
# CTRLAPI_PORTAL_DNS_PROVIDER=challtestsrv
# CTRLAPI_PORTAL_CHALLTESTSRV_URL=http://127.0.0.1:8055
#   Replaces the staging/production Let's Encrypt directory URL.
# CTRLAPI_PORTAL_ACME_DIRECTORY_URL=https://127.0.0.1:14000/dir
#   An extra root (PEM) trusted ONLY for the HTTPS connection to the ACME server (Pebble's minica).
# CTRLAPI_PORTAL_ACME_CA_FILE=/etc/stayconnect/portal-tls/pebble.minica.pem
#   host:port list replacing the zone's authoritative nameservers in the challenge propagation check.
# CTRLAPI_PORTAL_DNS_CHECK_SERVERS=127.0.0.1:8053
#   DNS-over-HTTPS JSON endpoints for hotel-domain checks (default: Cloudflare and Google).
# CTRLAPI_PORTAL_DOH_URLS=

# ---------------------------------------------------------------- tuning (defaults shown; leave commented)
# Fleet-wide assignment refresh horizon, seconds (0 = none). Reaching it marks an appliance's assignment STALE;
# it never unassigns it.
# CTRLAPI_ASSIGN_TTL_SECONDS=0
# Rotate the :9443 certificate this many days before expiry (default 30).
# CTRLAPI_SERVER_TLS_ROTATE_DAYS=30
