# CENTRAL (ctrlapi) SERVICE ENVIRONMENT — copy to /etc/stayconnect/ctrlapi.env on the Central host.
#
# Copy it, fill in the secrets, and leave the rest alone. Every value that a fresh Central deployment needs
# is named here, including the ones whose absence is silent: a Central that is missing
# CTRLAPI_APPLIANCE_BASE or CTRLAPI_VENDOR_KEY starts perfectly and simply cannot activate an appliance.
#
# Check a host with:  deploy/scripts/central-preflight.sh

# ---------------------------------------------------------------- identity of this deployment
CTRLAPI_ENV=production
CTRLAPI_ADDR=:8080
CTRLAPI_LOG_LEVEL=info

# ---------------------------------------------------------------- backing services
CTRLAPI_DB_URL=postgres://stayconnect:CHANGE_ME@127.0.0.1:5432/stayconnect?sslmode=require
CTRLAPI_REDIS_URL=redis://127.0.0.1:6379/0
CTRLAPI_NATS_URL=nats://127.0.0.1:4222

# ---------------------------------------------------------------- the browser side
# Origins allowed to call this API from a browser. The human admin UI, nothing else — appliances do not use
# CORS. Must be the real admin origin; the built-in default is loopback only, for development.
CTRLAPI_ALLOW_ORIGINS=https://admin.echofusion.com
CTRLAPI_COOKIE_SECURE=true

# ---------------------------------------------------------------- the appliance side
# What appliances dial — written into every offline activation package, and the address a hotel's appliance
# uses for the rest of its life.
#
# NORMALLY YOU DO NOT SET IT HERE. Run deploy/scripts/install-central-endpoint.sh, which installs the
# versioned deploy/config/central-endpoint.env to /etc/stayconnect/central-endpoint.env; the ctrlapi unit
# reads that file AFTER this one, so the fleet-wide value wins over anything hand-edited on a single host.
# The line below is a fallback for a host that has not installed it, and central-preflight.sh reports when
# the two disagree.
#
# There is no default. Unset in both places, Central starts normally and offline first activation is
# DISABLED with a log line saying so, rather than minting packages that name an endpoint nobody operates.
CTRLAPI_APPLIANCE_BASE=https://sc-central.echofusion.com

# Extra names/addresses the mTLS appliance listener's certificate must also be valid for. The certificate is
# issued for CTRLAPI_APPLIANCE_BASE's host plus 127.0.0.1 automatically; this is for a TRANSITION, where
# appliances already in the field still dial the old address. ctrlapi re-issues the certificate by itself
# when it finds one that does not cover every configured name, so changing the endpoint is one edit.
# CTRLAPI_MTLS_SANS=150.0.0.252

# ---------------------------------------------------------------- signing identities
# The vendor signing key: licences and offline activation packages. Created ONCE, ever, by
# deploy/scripts/vendor-signing-key.sh init, and carried to any future Central host with backup/restore.
# Never regenerate it on a reinstall — every appliance in the field is pinned to its public half.
CTRLAPI_VENDOR_KEY=/etc/stayconnect/vendor-license.key

# Assignment signing — deliberately a DIFFERENT key from the vendor key. An assignment must not be
# signable by the licence key, and ctrlapi refuses to sign assignments if it finds the two are the same.
CTRLAPI_ASSIGN_KEY=/etc/stayconnect/assignment-signing.key

# Root of the signed assignment-key trust registry the appliance verifies.
CTRLAPI_REGISTRY_ROOT_KEY=/etc/stayconnect/assignment-registry-root.key

# Command channel and signed updates. These two ARE generated on first start if absent, because losing them
# costs a re-issue rather than the fleet's trust.
CTRLAPI_COMMAND_KEY=/etc/stayconnect/command-signing.key
CTRLAPI_UPDATE_KEY=/etc/stayconnect/update-signing.key
