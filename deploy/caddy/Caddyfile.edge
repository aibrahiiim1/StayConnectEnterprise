# StayConnect - EDGE (Hotel Appliance) Caddyfile.
#
# ROLE BOUNDARY - read this before adding a site block.
#
# The Edge appliance terminates exactly TWO browser-facing surfaces:
#
#   portal.stayconnect.local            -> portald      127.0.0.1:8380   (guest captive portal)
#   hotel.stayconnect.local + <mgmt IP> -> hotel-admin  127.0.0.1:3100   (imported; see below)
#
# It does NOT run ctrlapi or cloud-admin. Those are CENTRAL CONTROL PLANE services on a separate
# server - see deploy/caddy/Caddyfile.central. This file previously carried their vhosts because a
# single all-in-one template was written when Central and Edge shared one box; when Central moved to
# its own host the services here were disabled but their vhosts stayed, so the Edge advertised
# api.stayconnect.local and admin.stayconnect.local and answered 502 on both.
#
# Do not add a Central vhost here. If a route 502s because its upstream "does not run on this box",
# the route does not belong on this box.
#
# The hotel-admin vhost is deliberately NOT inline: deploy/scripts/hotel-admin-cert-manager.sh
# regenerates /etc/caddy/hotel-admin/vhost.caddy whenever the management IP or certificate changes,
# and this file imports it. Edit that generator, not the import.
#
# To deploy:
#   install -m 0644 deploy/caddy/Caddyfile.edge /etc/caddy/Caddyfile
#   caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   systemctl reload stayconnect-caddy
#
{
	# Internal-only deployment: issue certs from Caddy's own local CA.
	# Flip to public ACME by swapping `local_certs` for `email …` (and
	# uncommenting `acme_ca` for staging).
	#
	#   email ops@yourdomain.com
	#   # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
	local_certs

	# Safer defaults across every site.
	servers {
		protocols h1 h2 h3
		# Trust our own reverse proxy's X-Forwarded-* from 127.0.0.1
		# (ctrlapi already validates these headers against the set below).
		trusted_proxies static 127.0.0.1/32 ::1/128
	}
}

# -------------------------------------------------------------------------
# Shared snippet: security headers we want on every response.
# -------------------------------------------------------------------------
(security_headers) {
	header {
		# HSTS: one year, include subdomains, submit to preload list once
		# you're confident you'll keep TLS on for good.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=()"
		# Remove Caddy's Server banner.
		-Server
	}
}

# -------------------------------------------------------------------------
# portal.stayconnect.local — guest captive portal (portald)
# -------------------------------------------------------------------------
# No CSP here: the guest portal renders inline JS in the voucher form and
# the OAuth/social handlers redirect to 3rd-party consent pages.
portal.stayconnect.local {
	import security_headers

	encode zstd gzip

	reverse_proxy 127.0.0.1:8380 {
		header_up X-Forwarded-Host  {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP         {remote_host}
	}

	log {
		output file /var/log/caddy/portal.log
		format json
	}
}

# -------------------------------------------------------------------------
# hotel.stayconnect.local — Hotel Admin UI (edge-first refactor)
# -------------------------------------------------------------------------
# Served ON the appliance for hotel staff, reachable via the MANAGEMENT
# network only. In production this vhost binds the appliance management IP
# (e.g. https://172.21.15.30) — never a WAN or guest-LAN address. The UI
# (Next.js :3100) proxies its own /api calls to edged (:8090) internally.
import /etc/caddy/hotel-admin/vhost.caddy
