[Unit]
Description=StayConnect Captive Portal Daemon (portald)
# Soft dependency on scd: portald dials scd's socket lazily per request and
# returns a transient error when scd is momentarily down, so the captive portal
# page itself keeps serving. scd being down must NOT stop portald (Wants=, not
# Requires=), and portald must never permanently fail on a start-limit.
After=network-online.target stayconnect-scd.service
Wants=network-online.target stayconnect-scd.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/stayconnect/portald.env
ExecStart=/opt/stayconnect/bin/portald
Restart=always
RestartSec=2
# ITS OWN USER, AND THIS IS THE SECURITY BOUNDARY IT EXISTS FOR.
#
# portald listens on *:8380 -- every guest VLAN -- and it used to run as User=stayconnect, the same account
# as edged. That made it the most exposed process on the appliance and gave it edged's identity: it could
# ptrace edged, and it could call every administrative route on /run/stayconnect/scd.sock directly,
# including /v1/backup/restore, /v1/license/install, /v1/central/offline-package and the voucher code reveal. None of
# those check an operator, because the operator authentication, permission check and password step-up all
# live in edged, and nothing proved they had happened.
#
# SupplementaryGroups, NOT Group. The socket is root:stayconnect-scd 0660 and guest authentication genuinely
# runs through it (commerce, sessions, phase3/5/6), so access to the socket must stay. Group membership does not
# buy the administrative surface: cmd/scd/admin_surface.go classifies every route and requires the peer to be
# edged's uid for the administrative ones.
#
# netd's socket (/run/stayconnect/netd.sock, root:stayconnect 0660) is no longer reachable at all: portald does
# not hold the stayconnect group (audit N-26), and netd also checks the caller's uid on every route
# (cmd/netd/caller_authz.go; audit B-2).
#
# The primary group stays portald's own, so anything it creates is not group-shared with edged by default.
User=stayconnect-portald
Group=stayconnect-portald
# NOT the stayconnect group any more (audit N-26). That group is edged's primary group: it opened scd's socket,
# but also edged's, netd's and acctd's env files (database credentials), the 0640 database dumps and netd's
# socket. stayconnect-scd opens scd's socket and nothing else.
SupplementaryGroups=stayconnect-scd
# Defence in depth: whatever a group grants in future, the portal never sees the backups.
InaccessiblePaths=-/opt/stayconnect/backups -/var/backups/stayconnect
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
# /run/stayconnect/health holds the adaptive-backoff tracker portald writes.
ReadWritePaths=/var/log/stayconnect /run/stayconnect/health
ReadOnlyPaths=/etc/stayconnect
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
