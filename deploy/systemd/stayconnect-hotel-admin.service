# hotel-admin — Next.js UI for hotel staff, served from the appliance.
# Binds 127.0.0.1:3100; Caddy exposes it on the management IP over TLS only.
#
# Runs the Next.js STANDALONE bundle (node server.js) from the atomic release
# symlink /opt/stayconnect/hotel-admin -> /opt/stayconnect/releases/hotel-admin/<stamp>.
# No npm and no build ever run on the appliance (see deploy/scripts/
# deploy-hotel-admin.sh) — this is what prevents a repeat of the /root build
# that exhausted the pilot's memory. A MemoryMax cap is a belt-and-braces
# guard so the UI process can never starve the box either.
[Unit]
Description=StayConnect Hotel Admin UI (Next.js standalone)
After=network-online.target stayconnect-edged.service
Wants=network-online.target stayconnect-edged.service
# Never permanently fail on a start-limit; the UI must always come back.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/stayconnect/hotel-admin
# Adaptive crash-loop backoff (see internal/startupbackoff).
ExecStartPre=/opt/stayconnect/bin/svc-run hotel-admin
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
EnvironmentFile=-/etc/stayconnect/hotel-admin.env
# ITS OWN USER, AND NO ACCESS TO scd's SOCKET.
#
# This ran as User=stayconnect -- edged's account -- so `/usr/bin/node server.js`, the process that renders
# the admin web UI, held edged's uid (998) and a primary group that opens /run/stayconnect/scd.sock. scd's
# administrative gate was checking the uid, so it admitted this process to /v1/backup/restore,
# /v1/license/install and /v1/setup/enroll with none of edged's operator authentication, permission check or
# step-up. Found by review, after portald had been separated for exactly the same reason.
#
# NO SupplementaryGroups, unlike portald. portald keeps the stayconnect group because guest authentication
# genuinely runs through that socket; hotel-admin talks to edged over HTTP on 127.0.0.1 and never opens the
# socket at all -- there is no scd reference anywhere in the Next application or its env file. So it gets no
# group, and the socket is simply not reachable from it.
#
# scd additionally requires the peer's EXECUTABLE to be edged for the administrative surface, which refuses
# this process even while it shares an account. That check landed with this change and takes effect on an
# scd restart; this unit removes the shared account the check exists to compensate for, because a process
# holding edged's uid can ptrace edged whatever scd checks.
User=stayconnect-hotel-admin
Group=stayconnect-hotel-admin
Restart=always
RestartSec=3
MemoryMax=768M
MemoryHigh=640M
OOMPolicy=stop
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
