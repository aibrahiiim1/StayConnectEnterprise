# netd — privileged network-configuration daemon (Phase 19).
# Root-owned; owns netplan/Kea/nftables/unbound for guest networks. Listens
# only on a protected unix socket. NEVER on TCP.
[Unit]
Description=StayConnect Network Daemon (privileged, guest networks + DHCP)
# NOTE: there is deliberately no postgresql.service here. There is no such unit
# on this appliance -- Postgres runs in the stayconnect-pg container -- and
# systemd silently ignores After= on a non-existent unit, so naming it only
# looked like ordering. docker.service orders after the DAEMON, not after the
# database inside the container, so the real gate is the ExecStartPre below.
After=network-online.target docker.service kea-dhcp4-server.service
Wants=network-online.target docker.service
# Never permanently give up: netd owns the guest networks/DHCP/nftables, so it
# must always recover automatically after a crash or a dependency delay.
StartLimitIntervalSec=0

[Service]
Type=simple
# netd connects to the site DB during startup and exits 1 if that fails, so it
# is the one daemon the cold-boot docker-proxy race actually crash-loops. The
# gate always exits 0 (see the script) -- worst case it hands back to
# Restart=always, exactly today's behaviour, never worse.
ExecStartPre=/opt/stayconnect/bin/wait-for-site-db.sh
ExecStart=/opt/stayconnect/bin/netd
# WHO MAY CALL WHICH ROUTE (cmd/netd/caller_authz.go). The socket is group-readable by every service in the
# stayconnect group -- portald holds that group for scd's socket -- so netd checks the kernel-reported uid
# (SO_PEERCRED) on every route and refuses anyone not named here. Unset or unresolvable = nobody (fail closed).
#   NETD_ADMIN_CALLERS  guest/system network configuration, leases, interfaces, health: edged, and root for the
#                       operator test scripts (scripts/phase19-*.sh)
#   NETD_FLOW_CALLERS   /v1/flows/end, the kernel half of a staff disconnect: scd (root)
#   NETD_EDGED_CALLER   the only caller whose request body names the audited actor; anyone else is recorded as
#                       itself ("local:<user>(<uid>)")
# The Phase-3 plan routes are authenticated separately against NETD_PHASE3_PRODUCER_UID (netd.env).
# netd.env may override any of these (EnvironmentFile wins over Environment=).
Environment=NETD_ADMIN_CALLERS=stayconnect,root
Environment=NETD_FLOW_CALLERS=root
Environment=NETD_EDGED_CALLER=stayconnect
EnvironmentFile=-/etc/stayconnect/netd.env
User=root
Group=root
Restart=always
RestartSec=2
RuntimeDirectory=stayconnect
RuntimeDirectoryMode=0755
# Shared /run/stayconnect also holds scd.sock; do NOT let a restart of any one
# service wipe the others' sockets.
RuntimeDirectoryPreserve=yes
# netd runs ip/nft/netplan/unbound-control and writes /etc/netplan + the
# generated bundle dir; it needs broad filesystem + net admin, so ProtectSystem
# is deliberately relaxed here (this is the one privileged surface).
NoNewPrivileges=no
# Systemd hardening (AD-28 b), proven on the test appliance (client journey 12/12, netd active, no denied operation in the
# journal; exposure 9.6 -> 7.8). Only what netd provably never needs is taken away: it keeps root, the network capabilities and
# NoNewPrivileges=no, because it starts helpers (kea, unbound, netplan, nft, tc) that it must be able to run as it does today.
ProtectHome=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
