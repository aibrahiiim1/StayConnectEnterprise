[Unit]
Description=StayConnect Session Controller Daemon (scd)
# docker.service: the site DB (stayconnect-pg) is a container, so order after
# Docker at cold boot. scd itself uses a lazy pgx pool (no startup Ping), so a
# slow DB does not crash it — this is ordering, not a hard requirement.
# No postgresql.service: it does not exist on this appliance (Postgres is the
# stayconnect-pg container) and systemd ignores After= on a missing unit, so it
# was never real ordering. scd's pgx pool is lazy, so it tolerates a slow DB
# anyway -- unlike netd, which is why only netd needed a readiness gate.
After=network-online.target docker.service nftables.service
# portald + acctd now Wants= scd (soft) rather than Require=, so they are not
# stopped when scd stops; Wants= here still pulls them back up when scd starts,
# so a scd stop/start (re-enrollment, assignment-driven restart, redeploy)
# leaves the whole guest plane converged with no manual intervention.
Wants=network-online.target docker.service stayconnect-portald.service stayconnect-acctd.service
Requires=nftables.service
# Never permanently give up (a slow DB/nftables at boot must not wedge the core
# daemon). StartLimitIntervalSec is a [Unit] directive.
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/stayconnect/scd.env
# FAIL CLOSED before the binary runs. A PMS-dependent guest surface enabled
# without its Phase-3 auth arm makes scd exit during startup, and because
# StartLimitIntervalSec=0 systemd then restarts it forever while
# `systemctl is-active` still answers "active" -- 596 restart jobs on the
# 2026-08-16 boot of this appliance before anyone looked. Refusing here means
# the scd binary never executes on such a config and every cycle logs one
# explicit REFUSED line naming the offending flag, instead of an opaque exit.
# (The primary gate is the deploy-time check; this is the boot-time backstop.)
ExecStartPre=/opt/stayconnect/bin/check-phase6-guest-dependency.sh /etc/stayconnect
# ...and wait for the site DB. The comment above this unit's After= line claimed scd's lazy pgx pool made
# it immune to a slow database. A measured reboot disproved that: pmsloader issues a query DURING startup
# and exits 1 when it fails, so scd crash-looped twice on the 2026-08-18 boot for exactly the reason netd
# did. The gate always exits 0, so the worst case is today's Restart=always behaviour.
ExecStartPre=/opt/stayconnect/bin/wait-for-site-db.sh
ExecStart=/opt/stayconnect/bin/scd
# Always recover. scd normally re-execs in place (same PID), so this only fires
# on an actual exit/crash.
Restart=always
RestartSec=2
# needs CAP_NET_ADMIN to run `nft`; running as root for Phase 1 simplicity
User=root
Group=root
RuntimeDirectory=stayconnect
RuntimeDirectoryMode=0755
ProtectSystem=full
# ProtectSystem=full makes /etc read-only, but three stores must persist there:
#   identity/   — the appliance's enrollment identity + signing key
#   license/    — the signed license envelope
#   assignment/ — the SIGNED ASSIGNMENT document: the appliance-local source of
#                 truth for tenant/site. Without this path scd cannot adopt an
#                 assignment ("read-only file system") and stays unassigned.
#   certs/      — the mTLS client certificate + CA bundle
ReadWritePaths=/etc/stayconnect/identity /etc/stayconnect/license /etc/stayconnect/assignment /etc/stayconnect/certs
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
