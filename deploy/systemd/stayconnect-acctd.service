[Unit]
Description=StayConnect Accounting Daemon (acctd)
# Soft dependencies: acctd polls scd's socket and the site DB per tick and
# tolerates either being momentarily unavailable (it logs and retries on the
# next tick), so scd being down must NOT stop it. docker.service for
# DB-container boot ordering.
After=network-online.target docker.service stayconnect-scd.service
Wants=network-online.target docker.service stayconnect-scd.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/stayconnect/acctd.env
# acctd inspects iam_v2 function privileges at startup and refuses to start if the DB is unreachable,
# so it hit the same cold-boot race: 8 restarts on the 2026-08-18 boot. Always exits 0; never worse.
ExecStartPre=/opt/stayconnect/bin/wait-for-site-db.sh
ExecStart=/opt/stayconnect/bin/acctd
Restart=always
RestartSec=2
# A stuck (not crashed) acctd stops renewing the 90 s authorization plan. The daemon pings only while its plan submitter
# is turning (sdwatchdog), so a stall is restarted within WatchdogSec instead of lasting until guests lose access.
# Type=simple + NotifyAccess=main: no start-up handshake is added.
WatchdogSec=30
NotifyAccess=main
User=root
Group=root
ProtectSystem=full
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
