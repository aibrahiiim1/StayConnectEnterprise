[Unit]
Description=OneGate monitor: deep sweep with client activity, device diagnostics and the health report
Documentation=file:///opt/stayconnect/monitor/README.md
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/stayconnect/monitor/onegate_monitor.py deep
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=384M
TimeoutStartSec=300
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/var/lib/onegate-monitor /var/log
